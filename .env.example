# ─────────────────────────────────────────────────────────────────────────────
# Fleetwright — environment variables
# Copy this to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────

# Root directory where Fleetwright stores state, worktrees, and logs.
# Defaults to ~/.fleetwright
# FLEETWRIGHT_ROOT=~/.fleetwright

# ── Fleet engine ──────────────────────────────────────────────────────────────

# Max parallel fleet runs (default: 10, no hard ceiling — hardware is the limit)
# FLEET_MAX_PARALLEL=10

# Override fleet worktree and log directories (default: under FLEETWRIGHT_ROOT)
# FLEET_WORKTREE_ROOT=~/.fleetwright/.fleet-worktrees
# FLEET_RUN_LOG_DIR=~/.fleetwright/logs/runs

# Base git branch for worktree spawning (default: main)
# FLEET_BASE_BRANCH=main

# Model tier overrides (see config/model-registry.yaml for tier names)
# MODEL_TIER_OVERRIDE_AGENT=claude-sonnet-4-6
# MODEL_TIER_OVERRIDE_FLAGSHIP=claude-fable-5
# MODEL_REGISTRY_PATH=/path/to/custom-model-registry.yaml

# ── Bridge ────────────────────────────────────────────────────────────────────

# Bridge host/port (default: 127.0.0.1:8787)
# HOST=127.0.0.1
# PORT=8787

# HMAC secret shared between bridge and cockpit (generate with `openssl rand -hex 32`)
BRIDGE_SECRET=change-me-generate-with-openssl-rand-hex-32

# Development mode (disables auth checks)
# DEV_MODE=false

# ── Database ──────────────────────────────────────────────────────────────────

# Database backend: sqlite (default, for dev) | postgres | supabase
# DB_BACKEND=sqlite

# SQLite file path (used when DB_BACKEND=sqlite)
# SQLITE_PATH=~/.fleetwright/state/fleetwright.db

# PostgreSQL connection string (used when DB_BACKEND=postgres)
# DATABASE_URL=postgresql://user:password@localhost:5432/fleetwright

# Supabase credentials (used when DB_BACKEND=supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key

# ── Domain registry ───────────────────────────────────────────────────────────

# Path to your domains config (default: config/domains.yaml)
# FLEETWRIGHT_DOMAINS_FILE=config/domains.yaml

# ── Notifications (optional) ──────────────────────────────────────────────────

# Telegram bot token + chat ID for agent alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
